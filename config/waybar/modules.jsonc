// -*- mode: jsonc -*-
// Module definitions shared by both bar layouts (config.jsonc = laptop,
// desktop.jsonc = desktop). Only the definitions live here: which modules a
// bar shows, and in what order, is in the layout file that includes this one.
// A layout file wins over this one on any key both set.
{
    // "sway/workspaces": {
    //     "disable-scroll": true,
    //     "all-outputs": true,
    //     "warp-on-scroll": false,
    //     "format": "{name}: {icon}",
    //     "format-icons": {
    //         "1": "",
    //         "2": "",
    //         "3": "",
    //         "4": "",
    //         "5": "",
    //         "urgent": "",
    //         "focused": "",
    //         "default": ""
    //     }
    // },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    "clock": {
        // "timezone": "America/New_York",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "custom/cpu-load": {
        "exec": "$HOME/.config/waybar/cpu.sh load",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "tooltip": true
    },
    "custom/cpu-temp": {
        "exec": "$HOME/.config/waybar/cpu.sh temp",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "tooltip": true
    },
    "custom/fan": {
        "exec": "$HOME/.config/waybar/fan.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "tooltip": true,
        "on-click": "/home/kannar/git/kannar/nunux/bin/tcc-profile"
    },
    "memory#ram": {
        "interval": 5,
        "format": "{used:0.1f}G {percentage}%",
        "tooltip-format": "{percentage}% used\n{used:0.1f}GiB used of {total:0.1f}GiB",
        "states": {
            "warning": 80,
            "blink": 90
        }
    },
    "memory#zram": {
        "interval": 5,
        "format": "{swapUsed:0.1f}G {swapPercentage}%",
        "tooltip-format": "Swap: {swapUsed:0.1f}/{swapTotal:0.1f}GiB"
    },
    // Root filesystem only -- one tile legitimately covers four mounts, and
    // /boot deliberately has none; bin/disk-watch's header explains both, and
    // is where the mount list actually lives.
    //
    // Display and thresholds are both {percentage_used} on purpose. waybar
    // derives percentage_used from statvfs f_bfree but percentage_free from
    // f_bavail, and `states` are only ever compared against percentage_used,
    // so showing free% while thresholding on used% left ~3 points of btrfs
    // reserve between the number on the bar and the number driving the colour
    // -- the tile blinked at 8% shown, not 10%. One field throughout fixes it.
    // These are still not df's percentages (df divides by used+avail), so the
    // tile trails disk-watch's alert by ~2 points: close, deliberately not
    // claimed as the same point.
    "disk": {
        "interval": 30,
        "path": "/",
        "unit": "GiB",
        "format": "{specific_free:0.0f}G {percentage_used}% ",
        "tooltip-format": "{used} used of {total} ({percentage_used}%)\n{free} free on {path}",
        "states": {
            "warning": 85,
            "blink": 90,
            "critical": 95
        }
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "custom/backlight": {
        "exec": "$HOME/.config/waybar/backlight.sh",
        "interval": 2,
        "format": "{}",
        "tooltip": false,
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 10
        },
        "format": "{capacity}% {icon}",
        "format-full": "",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "on-click": "/home/kannar/git/kannar/nunux/bin/charge-profile",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "custom/power-draw": {
        "exec": "$HOME/.config/waybar/power.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "tooltip": true
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "network": {
        "interface": "wlan*", // glob the wifi NIC (kernel names it wlanN, N shifts across re-probes) so docker bridges/veths do not hijack auto-select
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "format-alt-click": "click-right", // left click opens iwgtk
        "on-click": "iwgtk"
    },
    "custom/agenda": {
        // Next meeting from the Google secret iCal feeds in ~/.config/agenda/urls
        // (see agenda.py). Hover: today and the next two days as columns.
        "exec": "$HOME/.local/bin/uv run -q --script $HOME/.config/waybar/agenda.py",
        "return-type": "json",
        "interval": 30,
        "format": "{}",
        "tooltip": true,
        "on-click": "$HOME/.local/bin/uv run -q --script $HOME/.config/waybar/agenda.py open"
    },
    "custom/vpn": {
        "exec": "$HOME/.config/waybar/vpn.sh",
        "return-type": "json",
        "interval": 120,
        "format": "{}",
        "tooltip": true
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon}  {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-click-middle": "swayosd-client --output-volume mute-toggle",
        "on-scroll-up": "swayosd-client --output-volume raise",
        "on-scroll-down": "swayosd-client --output-volume lower"
    },
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    },
    // The bemenu chooser of $mod+Escape. This used to be waybar's GTK menu,
    // but its power_menu.xml was never in the repo, so the click did nothing.
    "custom/power": {
        "format" : "⏻ ",
        "tooltip": false,
        "on-click": "/home/kannar/git/kannar/nunux/bin/powermenu"
    },

    // ---- desktop only (desktop.jsonc) ----------------------------------

    // Wired link: address plus the negotiated speed, orange below 1 Gb/s, red
    // without carrier or IPv4. Added
    // after ocean's cable degraded for a week (1G -> 100M -> 10M, thousands
    // of carrier drops) with nothing on screen saying so.
    "custom/link": {
        "exec": "$HOME/.config/waybar/link.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "tooltip": true
    },
    // NVIDIA GPU: load, temperature, VRAM, and its fan when it spins. The only
    // nvidia-smi call per tick: custom/fans does not query the GPU.
    "custom/gpu": {
        "exec": "$HOME/.config/waybar/gpu.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "tooltip": true
    },
    // Motherboard fans (Super I/O hwmon, RPM). The GPU fan is in custom/gpu.
    "custom/fans": {
        "exec": "$HOME/.config/waybar/fans.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "tooltip": true
    }
}
