// -*- mode: jsonc -*-
// Laptop bar layout (the TUXEDO InfinityBook). It is waybar's default path, so
// a bare `waybar` gets it; the desktop profile starts `waybar -c desktop.jsonc`
// instead (config/sway/profile/desktop). Module definitions: modules.jsonc.
//
// Not shown although defined: power-profiles-daemon (not installed: tccd owns
// the power profile, fan tile), battery#bat2 (this machine has only BAT0),
// custom/media (its mediaplayer.py was never in the repo).
{
    "include": ["~/.config/waybar/modules.jsonc"],
    "height": 30, // Waybar height (to be removed for auto height)
    "spacing": 4, // Gaps between modules (4px) — touching-pair tiles in style.css cancel this with margin-left:-4px
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
        "network",
        "custom/vpn",
        "custom/cpu-load",
        "custom/cpu-temp",
        "memory#ram",
        "memory#zram",
        "disk",
        "custom/backlight",
        "custom/fan",
        "battery",
        "custom/power-draw",
        "clock",
        "tray",
        "custom/power"
    ]
}
