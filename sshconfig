Include ccadmingeneratedsshconfig
# Untracked host-specific entries (this repo is public); a missing file is ignored.
Include config.local

AddKeysToAgent yes

Host *
  ServerAliveInterval 15
  ServerAliveCountMax 20

Host *.clvrcld.net *.clever-cloud.com hv-* cellar-* hadoop-*
  User root

# Home LAN (10.0.0.0/24, static leases). ws1 is in config.local.
Host ocean
  HostName 10.0.0.151
  User kannar

Host pacific
  HostName 10.0.0.14
  User kannar

# Surface RT, écran mural de la salle à manger (Wi-Fi « Automation », IP fixe UniFi). One key only:
# the agent offers 7 and its sshd hangs up after 6 (system-config/hosts/surface-rt/README.md).
Host ecran-salon
  HostName 10.10.90.100
  User kannar
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

Host aur.archlinux.org
  User aur
  IdentityFile ~/.ssh/aur
  IdentitiesOnly yes

