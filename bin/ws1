#!/usr/bin/env bash
# ws1: offload compute to the Clever Cloud workstation VM (ssh alias `ws1`,
# defined in the untracked ~/.ssh/config.local because this repo is public).
#
# Everything runs as user kannar, driven by the Claude sessions on this laptop
# (see claude/WS1.md):
#
#   agents   `run` copies the current git tree over and starts a headless
#            `claude -p` in it, inside a tmux session, on kannar's own Claude
#            login. Its edits come back with `ws1 diff | git apply`.
#   builds   `sync` + `exec` copy the tree and run a command in it.
#
# Each sync commits the copied tree to a git repo of its own on ws1 and tags it
# ws1-sync, so `diff` shows exactly what happened there since. A sync overwrites
# remote edits to the files it sends: collect a run's diff before the next sync.
#
# kannar's home there is a LUKS volume (/data/kannar-home.luks) whose only key is
# $KEY on this laptop. Nothing on the VM can open it, so after a reboot it stays
# locked until `ws1 unlock`, and kannar cannot even log in: authorized_keys is
# inside it. Lose $KEY and the home is gone.
#
#   ws1 load                      one status line; exit 0 free, 1 busy, 2 unreachable
#   ws1 run [opts] <brief | ->    sync, start an agent in the same subdirectory, print its id
#       --wait      block until it ends and print its answer
#       --force     start even when ws1 is busy
#       --no-sync   run on what is already there
#   ws1 wait <id> [secs]          block until it ends (default 3600), print its answer
#   ws1 result <id>               print the answer of a finished run
#   ws1 ls                        runs: id, state, directory
#   ws1 kill <id>                 stop a run
#   ws1 diff                      what changed on ws1 since the last sync, as a patch
#   ws1 sync                      copy the current git tree to the same path under kannar's home
#   ws1 exec <command>            run a command there, in the same subdirectory
#   ws1 unlock | lock             open and mount, or unmount and close, kannar's home
#   ws1 sh [command]              ssh as kannar
set -euo pipefail

HOST=ws1
KEY="${XDG_DATA_HOME:-$HOME/.local/share}/ws1-home.key"
RHOME=/home/kannar
RUNS=.ws1/runs                      # under kannar's home
CLAUDE=$RHOME/.local/bin/claude
# Busy = the host would slow the work down more than this laptop would.
MAX_LOAD_PER_CORE=0.75
MIN_MEM_AVAIL_PCT=20

TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

die() { printf 'ws1: %s\n' "$*" >&2; exit 64; }
r() { ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST" "$@"; }
# As kannar. Fails while the home is locked, which is what keeps `sync` from
# ever writing into the bare mountpoint on the unencrypted disk.
u() {
	local rc=0
	ssh -o BatchMode=yes -o ConnectTimeout=10 -l kannar "$HOST" "$@" || rc=$?
	((rc != 255)) || echo "ws1: cannot log in as kannar (home locked? try: ws1 unlock)" >&2
	return $rc
}

run_id() {
	[[ "${1:-}" =~ ^[0-9]+-[0-9]+$ ]] || die "not a run id: ${1:-}"
	printf '%s\n' "$1"
}

load() {
	local out l1 n mem agents home
	out=$(r 'read -r l1 _ </proc/loadavg; echo "$l1 $(nproc) $(awk "/^MemTotal/{t=\$2} /^MemAvailable/{a=\$2} END{printf \"%d\", a*100/t}" /proc/meminfo) $(pgrep -u kannar -xc claude) $(mountpoint -q /home/kannar && echo unlocked || echo LOCKED)"') \
		|| { echo "ws1 unreachable"; return 2; }
	read -r l1 n mem agents home <<<"$out"
	if awk -v l="$l1" -v n="$n" -v m="$mem" -v L="$MAX_LOAD_PER_CORE" -v M="$MIN_MEM_AVAIL_PCT" \
		'BEGIN{exit !(l/n >= L || m < M)}'; then
		echo "ws1 busy: load $l1/$n cores, mem ${mem}% available, $agents agents, home $home"
		return 1
	fi
	echo "ws1 free: load $l1/$n cores, mem ${mem}% available, $agents agents, home $home"
}

result() {
	local id; id=$(run_id "${1:-}")
	u "d=$RUNS/$id; [ -d \$d ] || { echo 'ws1: no run $id' >&2; exit 64; }
		[ -f \$d/rc ] || { echo 'ws1: run $id still going' >&2; exit 1; }
		cat \$d/out; rc=\$(cat \$d/rc)
		[ \$rc = 0 ] || { echo \"ws1: run $id exited \$rc\" >&2; tail -20 \$d/err >&2; }
		exit \$rc"
}

wait_for() {
	local id; id=$(run_id "${1:-}")
	local secs="${2:-3600}"
	[[ "$secs" =~ ^[0-9]+$ ]] || die "timeout must be a number of seconds: $secs"
	u "end=\$((SECONDS + $secs))
		until [ -f $RUNS/$id/rc ]; do
			tmux has-session -t ws1-$id 2>/dev/null || [ -f $RUNS/$id/rc ] || { echo 'ws1: run $id died without a result' >&2; exit 5; }
			[ \$SECONDS -lt \$end ] || { echo 'ws1: run $id still going after ${secs}s' >&2; exit 4; }
			sleep 5
		done"
	result "$id"
}

run() {
	local words=() wait=0 force=0 nosync=0 brief=
	while (($#)); do
		case "$1" in
			--wait) wait=1; shift ;;
			--force) force=1; shift ;;
			--no-sync) nosync=1; shift ;;
			-) brief=$(cat); shift ;;
			-*) die "unknown option $1" ;;
			*) words+=("$1"); shift ;;
		esac
	done
	((${#words[@]} == 0)) || brief="${brief:+$brief }${words[*]}"
	[[ -n "$brief" ]] || die "missing brief"
	((force)) || load >&2 || die "not starting (run the agent locally, or pass --force)"
	if ((nosync)); then remote_paths; else sync >&2; fi

	local id; id="$(date +%s)-$RANDOM"
	# bypassPermissions: nobody is there to answer a prompt, and kannar is an
	# unprivileged user on a disposable VM, holding no credentials but Claude's.
	printf '%s' "$brief" | u "set -e; d=$RUNS/$id; mkdir -p \$d; cat >\$d/brief; echo $(printf '%q' "$REMOTE_CWD") >\$d/dir
		tmux new-session -d -s ws1-$id -c $(printf '%q' "$REMOTE_CWD") \
			\"$CLAUDE -p --permission-mode bypassPermissions <\$HOME/\$d/brief >\$HOME/\$d/out 2>\$HOME/\$d/err; echo \\\$? >\$HOME/\$d/rc\""
	echo "$id"
	((wait)) && wait_for "$id"
	return 0
}

list() {
	u "cd $RUNS 2>/dev/null || exit 0
		for d in */; do d=\${d%/}; [ -f \$d/dir ] || continue
			if [ -f \$d/rc ]; then s=\"exit \$(cat \$d/rc)\"; elif tmux has-session -t ws1-\$d 2>/dev/null; then s=running; else s=died; fi
			printf '%s\t%s\t%s\n' \$d \"\$s\" \"\$(cat \$d/dir)\"
		done"
}

kill_run() {
	local id; id=$(run_id "${1:-}")
	u "tmux kill-session -t ws1-$id 2>/dev/null; [ -f $RUNS/$id/rc ] || echo killed >$RUNS/$id/rc"
	echo "killed $id"
}

unlock() {
	[[ -r "$KEY" ]] || die "no key at $KEY"
	# The key crosses on stdin and is never written on the VM.
	r "mountpoint -q $RHOME && { echo 'already unlocked'; exit 0; }
		[ -e /dev/mapper/kannar-home ] || cryptsetup open --key-file - --allow-discards /data/kannar-home.luks kannar-home
		mount -o discard,nodev,nosuid /dev/mapper/kannar-home $RHOME && echo unlocked" <"$KEY"
}

lock() {
	# Drop kannar's multiplexed connection first: its shell would hold the mount busy.
	ssh -O exit -l kannar "$HOST" 2>/dev/null || true
	r "pkill -u kannar tmux; sleep 1
		! mountpoint -q $RHOME || umount $RHOME; [ ! -e /dev/mapper/kannar-home ] || cryptsetup close kannar-home; echo locked"
}

# Local git toplevel -> the same path under kannar's home, plus the subdirectory
# we are in. Git repos only: outside one there is no .gitignore to keep secrets
# back, and a bare `find` would ship ~/.local/share and ~/.ssh wholesale.
remote_paths() {
	local top home
	top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not in a git repository"
	home=$(realpath "$HOME")
	LOCAL_TOP=$top
	case "$top" in
		"$home"/*) REMOTE_TOP="$RHOME/${top#"$home"/}" ;;
		*) REMOTE_TOP="$RHOME/root${top}" ;;   # full path, so two repos named alike never share a directory
	esac
	REMOTE_CWD="$REMOTE_TOP/$(git rev-parse --show-prefix)"
}

sync() {
	remote_paths
	local q; q=$(printf '%q' "$REMOTE_TOP")
	# tar rather than rsync, which this laptop does not have. Only tracked and
	# untracked-but-not-ignored files travel, minus the skip-worktree ones, so
	# gitignored and locally-pinned secrets never leave the laptop and the
	# remote target/ survives as a build cache. The manifest of the previous
	# sync is what lets files deleted here be deleted there.
	(cd "$LOCAL_TOP" && git ls-files -co --exclude-standard -z \
		| grep -zvxFf <(git ls-files -v -z | sed -zn 's/^S //p' | tr '\0' '\n'; echo .ws1-manifest) \
		| while IFS= read -r -d '' f; do [[ -e "$f" || -L "$f" ]] && printf '%s\0' "$f"; done >"$TMP")
	u "mkdir -p $q && cd $q && cat >.ws1-manifest.new" <"$TMP"
	(cd "$LOCAL_TOP" && tar --null -T "$TMP" -cz) | u "cd $q && tar xz &&
		{ [ ! -f .ws1-manifest ] || sort -z .ws1-manifest | comm -z -23 - <(sort -z .ws1-manifest.new) | xargs -0 -r rm -f; } &&
		mv .ws1-manifest.new .ws1-manifest &&
		{ [ -d .git ] || { git init -q && echo .ws1-manifest >>.git/info/exclude; }; } &&
		git add -A && git -c user.name=ws1 -c user.email=ws1@localhost commit -q --allow-empty -m sync && git tag -f ws1-sync >/dev/null"
	echo "synced $LOCAL_TOP -> $HOST:$REMOTE_TOP ($(tr -cd '\0' <"$TMP" | wc -c) files)"
}

# Apply locally with `ws1 diff | git apply`. Covers commits an agent made there too.
diff_remote() {
	remote_paths
	u "cd $(printf '%q' "$REMOTE_TOP") && git add -A -N && git diff --binary ws1-sync"
}

case "${1:-}" in
	load) load ;;
	run) shift; run "$@" ;;
	wait) shift; wait_for "$@" ;;
	result) shift; result "$@" ;;
	ls) list ;;
	kill) shift; kill_run "$@" ;;
	diff) diff_remote ;;
	sync) sync ;;
	exec) shift; (($#)) || die "missing command"; remote_paths; u "cd $(printf '%q' "$REMOTE_CWD") && $*" ;;
	unlock) unlock ;;
	lock) lock ;;
	sh) shift; exec ssh -l kannar "$HOST" "$@" ;;
	*) sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"; exit 64 ;;
esac
