#!/usr/bin/env bash
# ws1: offload compute to the Clever Cloud workstation VM (ssh alias `ws1`,
# defined in the untracked ~/.ssh/config.local because this repo is public).
#
# Two ways to use it, both driven by the Claude sessions on this laptop (see
# claude/WS1.md):
#
#   agents   `run` spawns a headless Claude session in a container there, through
#            claude-hive. It clones the repo from GitLab on its own branch, so it
#            sees only what is pushed, and it runs on a team-lent subscription.
#   builds   `sync` + `exec` copy the working tree and run a command on the host
#            itself, as user kannar: uncommitted work, repos that are not on the
#            Clever GitLab.
#
# kannar's home there is a LUKS volume (/data/kannar-home.luks) whose only key is
# $KEY on this laptop. Nothing on the VM can open it, so after a reboot it stays
# locked until `ws1 unlock`, and kannar cannot even log in: authorized_keys is
# inside it. Lose $KEY and the home is gone.
#
#   ws1 load                      one status line; exit 0 free, 1 busy, 2 unreachable
#   ws1 run [opts] <brief | ->    spawn a session, print its name
#       --repo g/p  --extra g/p  --branch b  --name n     passed to claude-hive
#       --wait      block until the brief ends and print its answer
#       --force     spawn even when ws1 is busy
#   ws1 wait <session> [secs]     block until the brief ends (default 3600), print its answer
#   ws1 result <session>          print the answer of a finished brief
#   ws1 ls                        hive sessions; `*` marks the ones spawned from here
#   ws1 kill <session>            remove a session, its GitLab token and its Claude secret
#   ws1 sync                      copy the current git tree to the same path under kannar's home
#   ws1 exec <command>            run a command there as kannar, in the same subdirectory
#   ws1 unlock | lock             open and mount, or unmount and close, kannar's home
#   ws1 sh [command]              plain ssh
#
# `kill` only takes sessions recorded in $STATE unless --force: other sessions on
# the host were started by hand and may hold unpushed work.
set -euo pipefail

HOST=ws1
HIVE=/data/claude-hive/target/release/claude-hive
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/ws1/spawned"
KEY="${XDG_DATA_HOME:-$HOME/.local/share}/ws1-home.key"
RHOME=/home/kannar
# Busy = the host would slow the work down more than this laptop would.
MAX_LOAD_PER_CORE=0.75
MIN_MEM_AVAIL_PCT=20

TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

die() { printf 'ws1: %s\n' "$*" >&2; exit 64; }
r() { ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST" "$@"; }
# As kannar. Fails while the home is locked, which is what keeps `sync` from
# ever writing into the bare mountpoint on the unencrypted disk.
u() {
	local rc=0
	ssh -o BatchMode=yes -o ConnectTimeout=10 -l kannar "$HOST" "$@" || rc=$?
	((rc != 255)) || echo "ws1: cannot log in as kannar (home locked? try: ws1 unlock)" >&2
	return $rc
}

# Accepts a container name or a bare session id.
container() {
	local c="${1:-}"
	[[ -n "$c" ]] || die "missing session"
	[[ "$c" == claude-hive-* ]] || c="claude-hive-$c"
	[[ "$c" =~ ^claude-hive-[0-9]+-[0-9a-f]+$ ]] || die "not a session: $1"
	printf '%s\n' "$c"
}

load() {
	local out l1 n mem sessions home
	out=$(r 'read -r l1 _ </proc/loadavg; echo "$l1 $(nproc) $(awk "/^MemTotal/{t=\$2} /^MemAvailable/{a=\$2} END{printf \"%d\", a*100/t}" /proc/meminfo) $(podman ps -q --filter label=claude-hive | wc -l) $(mountpoint -q /home/kannar && echo unlocked || echo LOCKED)"') \
		|| { echo "ws1 unreachable"; return 2; }
	read -r l1 n mem sessions home <<<"$out"
	if awk -v l="$l1" -v n="$n" -v m="$mem" -v L="$MAX_LOAD_PER_CORE" -v M="$MIN_MEM_AVAIL_PCT" \
		'BEGIN{exit !(l/n >= L || m < M)}'; then
		echo "ws1 busy: load $l1/$n cores, mem ${mem}% available, $sessions sessions, home $home"
		return 1
	fi
	echo "ws1 free: load $l1/$n cores, mem ${mem}% available, $sessions sessions, home $home"
}

result() {
	local c; c=$(container "${1:-}")
	# `claude -p` prints its answer on the container's tty, between two [hive] lines.
	r "podman logs $c 2>&1" | tr -d '\r' | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | awk '
		/^\[hive\] running the spawn prompt/ { on = 1; next }
		/^\[hive\] prompt run ended/ { print > "/dev/stderr"; done = 1; exit }
		on
		END { if (!done) { print "ws1: brief still running" > "/dev/stderr"; exit 1 } }'
	r "podman inspect -f '{{with index .Config.Labels \"hive.repo\"}}repo {{.}}, branch {{index \$.Config.Labels \"hive.branch\"}}{{end}}' $c" >&2
}

wait_for() {
	local c; c=$(container "${1:-}")
	local secs="${2:-3600}"
	r "end=\$((SECONDS + $secs))
		until podman logs $c 2>&1 | grep -aq '^\[hive\] prompt run ended'; do
			[ \"\$(podman inspect -f '{{.State.Status}}' $c)\" = running ] || { echo 'ws1: $c is not running' >&2; exit 5; }
			[ \$SECONDS -lt \$end ] || { echo 'ws1: $c still running after ${secs}s' >&2; exit 4; }
			sleep 15
		done"
	result "$c"
}

run() {
	local args=() wait=0 force=0 brief=
	while (($#)); do
		case "$1" in
			--repo|--extra|--branch|--name) args+=("$1" "${2:?$1 needs a value}"); shift 2 ;;
			--wait) wait=1; shift ;;
			--force) force=1; shift ;;
			-) brief=$(cat); shift ;;
			-*) die "unknown option $1" ;;
			*) brief="$*"; break ;;
		esac
	done
	[[ -n "$brief" ]] || die "missing brief"
	((force)) || load >&2 || die "not spawning (run the agent locally, or pass --force)"

	# The host's own account when one is configured, else the team registry's
	# highest lendable quota.
	local line c
	line=$(printf '%s' "$brief" | r "a=--highest-quota; [ -s ~/.config/claude-hive/claude.token ] && a=
		$HIVE spawn \$a $(printf '%q ' "${args[@]}") --prompt-file -")
	c=$(grep -o 'claude-hive-[0-9]*-[0-9a-f]*' <<<"$line" | head -1) || die "spawn failed: $line"
	mkdir -p "${STATE%/*}"
	echo "$c" >>"$STATE"
	echo "$line" >&2
	echo "$c"
	((wait)) && wait_for "$c"
	return 0
}

list() {
	r "podman ps -a --filter label=claude-hive --format '{{.Names}}\t{{.Status}}\t{{.Label \"hive.repo\"}}\t{{.Label \"hive.branch\"}}'" \
		| while IFS=$'\t' read -r name rest; do
			if grep -qxF "$name" "$STATE" 2>/dev/null; then echo "* $name	$rest"; else echo "  $name	$rest"; fi
		done
}

kill_session() {
	local force=0
	[[ "${1:-}" == --force ]] && { force=1; shift; }
	local c; c=$(container "${1:-}")
	local id="${c#claude-hive-}"
	((force)) || grep -qxF "$c" "$STATE" 2>/dev/null || die "$c was not spawned from here (--force to remove it anyway)"
	# Same three steps as the TUI's `x`, minus the transcript copy.
	r "repo=\$(podman inspect -f '{{index .Config.Labels \"hive.repo\"}}' $c 2>/dev/null)
		podman rm -f -v $c >/dev/null
		podman secret rm hive-claude-$id >/dev/null 2>&1 || true
		[ -z \"\$repo\" ] || $HIVE broker revoke --session $id 2>&1 | tail -1"
	[[ -f "$STATE" ]] && sed -i "\|^$c\$|d" "$STATE"
	echo "killed $c"
}

unlock() {
	[[ -r "$KEY" ]] || die "no key at $KEY"
	# The key crosses on stdin and is never written on the VM.
	r "mountpoint -q $RHOME && { echo 'already unlocked'; exit 0; }
		[ -e /dev/mapper/kannar-home ] || cryptsetup open --key-file - --allow-discards /data/kannar-home.luks kannar-home
		mount -o discard,nodev,nosuid /dev/mapper/kannar-home $RHOME && echo unlocked" <"$KEY"
}

lock() {
	# Drop kannar's multiplexed connection first: its shell would hold the mount busy.
	ssh -O exit -l kannar "$HOST" 2>/dev/null || true
	r "! mountpoint -q $RHOME || umount $RHOME; [ ! -e /dev/mapper/kannar-home ] || cryptsetup close kannar-home; echo locked"
}

# Local git toplevel -> the same path under kannar's home, plus the subdirectory we are in.
remote_paths() {
	local top; top=$(git rev-parse --show-toplevel 2>/dev/null) || top=$PWD
	LOCAL_TOP=$top
	if [[ "$top" == "$HOME"/* ]]; then REMOTE_TOP="$RHOME/${top#"$HOME"/}"; else REMOTE_TOP="$RHOME/work/${top##*/}"; fi
	REMOTE_CWD="$REMOTE_TOP${PWD#"$top"}"
}

sync() {
	remote_paths
	local q; q=$(printf '%q' "$REMOTE_TOP")
	# tar rather than rsync, which this laptop does not have. Only tracked and
	# untracked-but-not-ignored files travel, minus the skip-worktree ones, so
	# gitignored and locally-pinned secrets never leave the laptop and the remote target/ survives as a build cache. The manifest
	# of the previous sync is what lets files deleted here be deleted there.
	(cd "$LOCAL_TOP" && { git ls-files -co --exclude-standard -z 2>/dev/null || find . -type f -print0; } \
		| grep -zvxFf <(git ls-files -v 2>/dev/null | sed -n 's/^S //p'; echo .ws1-manifest) \
		| while IFS= read -r -d '' f; do [[ -e "$f" || -L "$f" ]] && printf '%s\0' "$f"; done >"$TMP")
	u "mkdir -p $q && cd $q && cat >.ws1-manifest.new" <"$TMP"
	(cd "$LOCAL_TOP" && tar --null -T "$TMP" -cz) | u "cd $q && tar xz &&
		{ [ ! -f .ws1-manifest ] || sort -z .ws1-manifest | comm -z -23 - <(sort -z .ws1-manifest.new) | xargs -0 -r rm -f; } &&
		mv .ws1-manifest.new .ws1-manifest"
	echo "synced $LOCAL_TOP -> $HOST:$REMOTE_TOP ($(tr -cd '\0' <"$TMP" | wc -c) files)"
}

case "${1:-}" in
	load) load ;;
	run) shift; run "$@" ;;
	wait) shift; wait_for "$@" ;;
	result) shift; result "$@" ;;
	ls) list ;;
	kill) shift; kill_session "$@" ;;
	sync) sync ;;
	exec) shift; (($#)) || die "missing command"; remote_paths; u "cd $(printf '%q' "$REMOTE_CWD") && $*" ;;
	unlock) unlock ;;
	lock) lock ;;
	sh) shift; exec ssh "$HOST" "$@" ;;
	*) sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"; exit 64 ;;
esac
